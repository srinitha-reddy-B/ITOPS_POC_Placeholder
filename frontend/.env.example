# Copy to frontend/.env (optional -- these are the defaults).

# Where the FastAPI backend is listening. Start it with:
#   cd backend; uv run uvicorn app.main:app --port 8001 --reload
AURA_API_ORIGIN=http://127.0.0.1:8001

# Where this frontend listens. Use HOST=0.0.0.0 to open it to other machines.
PORT=3000
HOST=127.0.0.1
