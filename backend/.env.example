# Optional: enables real LLM-based blueprint generation instead of the keyword heuristic.
COHERE_API_KEY=
# Optional: override the Cohere chat model (default: command-a-03-2025).
COHERE_MODEL=
 
# Optional: enables a REAL Salesforce connection (OAuth "Connect to Salesforce" button in chat)
# instead of mocked Salesforce data. Requires a Salesforce Connected App -- see README.md.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Sandbox org? use https://test.salesforce.com instead (default: https://login.salesforce.com).
SALESFORCE_LOGIN_URL=
# Must exactly match the Connected App's Callback URL.
SALESFORCE_REDIRECT_URI=http://localhost:3000/connect/salesforce/callback
 
# Agentic ITOps live ServiceNow (username/password added by the user)
AURA_ITOPS_SNOW_INSTANCE=https://devXXXXXX.service-now.com
AURA_ITOPS_SNOW_USERNAME=
AURA_ITOPS_SNOW_PASSWORD=
 
# Agentic ITOps live Jira (email = the Atlassian account that owns the API token)
AURA_ITOPS_JIRA_SITE=https://your-site.atlassian.net
AURA_ITOPS_JIRA_PROJECT=
AURA_ITOPS_JIRA_EMAIL=
AURA_ITOPS_JIRA_TOKEN=
 
# RCA Writer uses a stronger model (command-r7b kept misstating the root cause; benchmarked 12 Nov 2026: ~43 s per call)
P32_AGENT_MODEL_RCA=command-r-plus-08-2024
P32_AGENT_TIMEOUT=120

# Crystal Clean Service Hub (optional): real identity fixes through Okta (free Integrator plan).
# Without these the hub uses a local demo directory. See docs/CRYSTAL_CLEAN_DEMO.md.
OKTA_ORG_URL=
OKTA_API_TOKEN=
CC_LOGIN_MARCUS=
CC_LOGIN_LUIS=
