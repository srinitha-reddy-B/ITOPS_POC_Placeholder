{
  "uid": "cc-network",
  "title": "Crystal Clean \u00b7 4 \u00b7 Branch connectivity (lab links)",
  "description": "Blackbox Exporter probes. The branch links are Toxiproxy lab proxies on this machine, not Crystal Clean's network.",
  "tags": [
    "crystal-clean",
    "ops-console"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": false,
  "panels": [
    {
      "type": "stat",
      "title": "Chicago North probe loss",
      "datasource": {
        "type": "prometheus",
        "uid": "cc-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (facility) (avg_over_time(probe_success{link=\"vpn-wan\",facility=\"CC-CHICAGO-NORTH\"}[30s])))",
          "datasource": {
            "type": "prometheus",
            "uid": "cc-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
